# ═══════════════════════════════════════════════════════════════
# OpenCenterAI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ── IG Broker ──────────────────────────────────────────────────
OC_IG_MODE=DEMO
OC_IG_USERNAME=
OC_IG_PASSWORD=
OC_IG_API_KEY=
OC_IG_ACC_NUMBER=

# ── Claude AI ──────────────────────────────────────────────────
OC_CLAUDE_API_KEY=
OC_CLAUDE_MODEL_PRIMARY=claude-haiku-4-5-20251001
OC_CLAUDE_MODEL_CRITICAL=claude-sonnet-4-20250514

# ── MongoDB ────────────────────────────────────────────────────
OC_MONGO_URI=mongodb://127.0.0.1:27017
OC_MONGO_DB=opencenterai

# ── App ────────────────────────────────────────────────────────
OC_HOST=0.0.0.0
OC_PORT=5002
OC_DEBUG=false

# ── Auth ───────────────────────────────────────────────────────
OC_AUTH_LOGIN=admin
OC_AUTH_PASSWORD=changeme
OC_SECRET_KEY=opencenterai-prod-secret-change-me
OC_IP_WHITELIST=127.0.0.1,::1

# ── Logging ────────────────────────────────────────────────────
OC_LOG_LEVEL=INFO
OC_LOG_FILE=logs/trading.log
